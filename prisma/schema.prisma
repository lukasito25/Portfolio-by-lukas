// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials authentication
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]

  // Portfolio content relationships
  projects      Project[]
  blogPosts     BlogPost[]
  recruiterPages RecruiterPage[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Portfolio content models
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String
  excerpt     String?

  // Media and assets
  thumbnail   String?
  images      String? // JSON string of image URLs
  demoUrl     String?
  githubUrl   String?

  // Metadata
  technologies Technology[] @relation("ProjectTechnologies")
  category    String?
  status      ProjectStatus @default(DRAFT)
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Author
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  // Analytics
  views       Int       @default(0)
  likes       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?

  // Media
  thumbnail   String?

  // Metadata
  tags        Tag[]     @relation("BlogPostTags")
  category    String?
  status      PostStatus @default(DRAFT)
  featured    Boolean   @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Author
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  // Analytics
  views       Int       @default(0)
  likes       Int       @default(0)
  readTime    Int?      // estimated read time in minutes

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model Technology {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?   // URL or icon identifier
  color       String?   // hex color code
  category    String?   // e.g., "Frontend", "Backend", "Database"
  level       SkillLevel @default(BEGINNER)

  projects    Project[] @relation("ProjectTechnologies")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  color     String?    // hex color code

  blogPosts BlogPost[] @relation("BlogPostTags")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String?
  message     String
  phone       String?
  company     String?

  // Project details
  projectType String?
  budgetRange String?
  source      String?

  // Status tracking
  status      ContactStatus @default(NEW)
  responded   Boolean   @default(false)
  respondedAt DateTime?

  // Spam protection
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Newsletter {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  subscribed  Boolean  @default(true)
  confirmed   Boolean  @default(false)

  // Tracking
  source      String?  // where they subscribed from
  ipAddress   String?

  subscribedAt DateTime @default(now())
  confirmedAt  DateTime?
  unsubscribedAt DateTime?
}

/// Geo-targeted homepage banner routing recruiters to a fit-brief page.
/// Managed from /admin/campaigns; seeded from src/lib/location-campaigns.ts,
/// which remains the fallback if the database is unreachable.
model LocationCampaign {
  id        String   @id // stable slug, e.g. "launchmetrics-fr"
  countries String // comma-separated ISO 3166-1 alpha-2, e.g. "FR,IT"
  cities    String? // optional comma-separated city names
  startsAt  String // YYYY-MM-DD — drives the 2-month auto-expiry cap
  endsAt    String? // optional earlier end; clamped to the cap
  isActive  Boolean  @default(true) // the admin on/off switch
  eyebrow   String
  title     String
  body      String
  ctaLabel  String
  href      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Fit briefs produced by the application engine (/admin/applications) and
/// rendered by the data-driven /brief/[slug] route. The eleven hand-built
/// briefs (/fifa, /genius, …) are compiled pages and are NOT stored here.
///
/// Mirrors cloudflare-api/migrations/add_generated_briefs.sql — production
/// reads and writes D1; this model is the local-dev equivalent. JSON columns
/// are stored as strings because SQLite has no JSON type; the app validates
/// them with zod on both sides.
model GeneratedBrief {
  id           String    @id @default(cuid())
  slug         String    @unique
  companyName  String
  roleTitle    String
  sourceUrl    String?
  sourceKind   String    @default("text") // url | pdf | image | text
  status       String    @default("draft") // draft | published | archived
  /// Random per-brief token. A draft renders only at ?preview=<token>.
  previewToken String
  jobSpec      String    @default("{}")
  content      String    @default("{}") // { en, it, de }
  /// Immutable first-generation copy. Never edited — it is the baseline the
  /// edit-learning loop diffs against to work out how he rewrites things.
  generatedContent String @default("{}")
  cvContent    String    @default("{}")
  coverLetter  String    @default("{}")
  /// Frozen first-generation copies, the document equivalents of
  /// `generatedContent`. A hand edit is diffed against the generation, not
  /// against the previous save — the pair worth learning from is "what the
  /// model wrote → what he actually sends", not the last increment.
  generatedCvContent   String @default("{}")
  generatedCoverLetter String @default("{}")
  brand        String    @default("{}")
  warnings     String    @default("[]")
  /// Whether this application is worth the time: score, band, per-must-have
  /// status and the arithmetic it was derived from. Stored rather than
  /// recomputed — it costs a model call and only moves when the posting or the
  /// brief does.
  fitAssessment String   @default("{}")
  /// Checks he has reviewed and accepted, as a JSON array of stable keys
  /// (code|locale|path). Warnings are recomputed from the validators on every
  /// save, so a dismissal cannot live in `warnings` — the next edit would
  /// overwrite it. The recompute filters against this instead.
  dismissedWarnings String @default("[]")

  /// Application pipeline, separate from `status` (which is page publication).
  /// not_sent | sent | acknowledged | interview | rejected | offer | withdrawn
  applicationStatus String  @default("not_sent")
  sentAt            DateTime?
  /// email | portal | linkedin | referral | other
  sentVia           String?
  /// Frozen copy of exactly what was sent. Later edits must not rewrite history.
  sentSnapshot      String   @default("{}")
  outcomeNotes      String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?

  edits        ApplicationEdit[]

  @@index([status])
  @@index([applicationStatus])
  @@index([updatedAt])
}

/// One field he rewrote by hand before sending.
///
/// This is the highest-value training signal in the whole system: the diff
/// between what was generated and what he was willing to put his name on is the
/// most direct evidence of his actual voice. Recent pairs are fed back into
/// generation, and periodically distilled into durable style rules.
model ApplicationEdit {
  id        String   @id @default(cuid())
  briefId   String
  brief     GeneratedBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  /// brief | cv | letter
  kind      String
  locale    String
  /// Dotted path into the content, e.g. "hero.description".
  path      String
  before    String
  after     String
  /// What he asked for, when the change came from a typed instruction rather
  /// than a direct hand edit. The diff shows that a sentence changed; this
  /// shows why, and the why is the part that generalises to the next
  /// application. Null for hand edits.
  instruction String?
  /// Set once a distillation run has folded this into the style rules.
  distilled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([briefId])
  @@index([distilled])
  @@index([createdAt])
}

/// One job posting found by the automatic search in /admin/applications.
///
/// The search half of the engine is the mirror of `GeneratedBrief`: that table
/// holds applications he decided to write, this one holds postings he has not
/// decided about yet. Keeping them separate matters — a lead is disposable and
/// re-found on every search, a brief is a piece of work with his name on it.
///
/// Rows persist so a repeat search can be honest about what is genuinely new.
/// A dismissed posting must come back dismissed rather than as a fresh
/// suggestion, or the second search costs as much attention as the first and
/// the feature stops saving anything.
model JobLead {
  id           String   @id @default(cuid())
  /// Normalised posting URL — the dedupe key. One posting, one row, however
  /// many searches surface it.
  url          String   @unique
  title        String
  companyName  String
  location     String   @default("")
  /// onsite | hybrid | remote | unspecified
  workModel    String   @default("unspecified")
  /// Compensation exactly as the posting words it. Empty when it says nothing —
  /// never an inference, because a salary he was shown and not offered is worse
  /// than no number at all.
  salaryText   String   @default("")
  postedText   String   @default("")
  /// The posting date as YYYY-MM-DD when it could be determined, else empty.
  /// Kept alongside `postedText` because the words are what he reads and the
  /// date is what the staleness filter acts on.
  postedIso    String   @default("")
  /// The board or careers-site host the posting sits on.
  source       String   @default("")
  summary      String   @default("")
  /// JSON string[] — the requirements the search could see, which is what the
  /// lead score was computed from and all it may be held to.
  requirements String   @default("[]")
  /// live | gone | unverified. Set by an actual request to the URL, never by
  /// the model that reported it. `unverified` is its own answer: a board that
  /// blocks server requests is not a posting that has been taken down.
  liveness     String   @default("unverified")
  /// The cheap pre-generation score, 0-100. Deliberately NOT the fit score in
  /// `GeneratedBrief.fitAssessment`: that one reads the brief's own requirement
  /// rows and cannot exist before the brief does.
  leadScore    Int      @default(0)
  band         String   @default("long-shot")
  recommendation String @default("apply-if-time")
  /// Named when something makes this near-impossible regardless of fit. A
  /// non-empty value caps the score at 19, enforced in the route as well as in
  /// the prompt.
  hardBlocker  String   @default("")
  /// { verdict, drivers[], risks[] }
  scoreDetail  String   @default("{}")
  /// new | saved | dismissed | applied
  state        String   @default("new")
  /// Set once this lead became an application.
  briefId      String?
  /// The search criteria that found it, for "why am I being shown this".
  criteria     String   @default("{}")
  foundAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([state])
  @@index([leadScore])
  @@index([foundAt])
}

/// A job search that runs on a schedule, without him pressing anything.
///
/// The manual search competes with the part of the day he could spend writing
/// applications. This is the same search, run overnight, so the morning starts
/// with results rather than with a two-minute wait.
///
/// `criteria` holds exactly the JobSearchCriteria the manual panel posts, so a
/// scheduled run and a manual one cannot diverge in what they ask for.
model SavedSearch {
  id            String    @id @default(cuid())
  name          String
  /// JSON JobSearchCriteria — the same shape /api/admin/job-search accepts.
  criteria      String    @default("{}")
  /// daily | every-2-days | weekly
  frequency     String    @default("daily")
  /// Hour of day in UTC the run should land on, so results are there by morning.
  hourUtc       Int       @default(3)
  isActive      Boolean   @default(true)
  notifyByEmail Boolean   @default(true)
  /// Leads below this are still stored, just never emailed. 45 is the bottom of
  /// the "credible" band — see SCORE_BANDS in src/lib/fit-brief/fit-score.ts.
  minScore      Int       @default(45)
  lastRunAt     DateTime?
  /// Consecutive runs that surfaced nothing new. Drives the auto-pause, so a
  /// badly worded search cannot burn the Gemini quota nightly forever.
  emptyRuns     Int       @default(0)
  /// Why the scheduler switched it off, so a pause is visible rather than a
  /// search that quietly stopped working.
  pausedReason  String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
}

/// One scheduled execution.
///
/// The only way to answer "did it run last night". A scheduler nobody watches
/// needs a record, or a broken one is indistinguishable from a quiet job
/// market — which is the same confusion the search's coverage note exists to
/// prevent, one level up.
model ScheduledRun {
  id        String   @id @default(cuid())
  searchId  String
  startedAt DateTime @default(now())
  /// ok | empty | error | skipped
  status    String   @default("ok")
  newLeads  Int      @default(0)
  /// How many of those cleared minScore and were actually emailed.
  notified  Int      @default(0)
  costUsd   Float    @default(0)
  note      String   @default("")

  @@index([searchId])
  @@index([startedAt])
}

model Analytics {
  id          String   @id @default(cuid())

  // Page analytics
  path        String
  title       String?

  // User info (anonymized)
  sessionId   String
  ipAddress   String?
  userAgent   String?
  country     String?
  city        String?

  // Referrer / attribution info
  referrer    String?
  source      String?   // e.g., "google", "direct", "github"
  medium      String?   // e.g., "organic", "social", "referral"
  campaign    String?
  ref         String?   // per-recruiter link tag from ?ref=

  // Visitor info
  isReturning Boolean   @default(false) // first-party returning visitor (90d)
  isOwner     Boolean   @default(false) // the site owner's own visit (excluded from the dashboard by default)

  // Traffic quality — see src/lib/analytics-classify.ts
  isBot       Boolean   @default(false) // automated traffic (excluded by default)
  botReason   String?   // cli | crawler | ai-bot | fetcher | email-scanner | headless | empty-ua
  isHuman     Boolean   @default(false) // confirmed by the client-side beacon (JS actually ran)
  browser     String?
  os          String?
  deviceType  String?   // desktop | mobile | tablet
  refHost     String?   // normalised referrer host, 'direct' for none/self

  // Engagement metrics
  duration    Int?      // time spent on page in seconds
  scrollDepth Int?      // percentage of page scrolled (0-100)
  bounce      Boolean   @default(false)

  createdAt   DateTime  @default(now())

  @@index([path])
  @@index([sessionId])
  @@index([createdAt])
  @@index([ref])
}

model MediaFile {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int      // file size in bytes
  url         String   // URL to access the file
  alt         String?  // alt text for images

  // Metadata
  width       Int?     // for images
  height      Int?     // for images

  // Organization
  folder      String?  // virtual folder structure
  tags        String? // JSON string for categorization

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Enums
enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

// Recruiter Landing Page System Models
model RecruiterPage {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  companyName  String
  companySlug  String
  isActive     Boolean  @default(true)

  // Target Role & Company
  roleName     String?
  roleLevel    String?  // "Director", "VP", "Chief"
  companySize  String?  // "Startup", "Growth", "Enterprise"
  industry     String?  // "B2B SaaS", "E-commerce", "FinTech"

  // Template & Personalization
  templateType String   // "company-mirror", "day-one-impact", "executive-briefing"
  customContent Json?   // Flexible content structure

  // Company Research Integration
  companyInfo  Json?    // Researched company data
  challenges   Json?    // Identified challenges array
  solutions    Json?    // Proposed solutions array

  // Analytics & Performance
  views        Int      @default(0)
  uniqueViews  Int      @default(0)
  timeOnPage   Int?     // Average seconds
  responses    Int      @default(0)

  // Metadata
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  analytics    RecruiterPageAnalytics[]
  interactions RecruiterPageInteraction[]

  @@index([companySlug])
  @@index([templateType])
  @@index([authorId])
}

// Page Analytics Tracking
model RecruiterPageAnalytics {
  id           String       @id @default(cuid())
  pageId       String
  page         RecruiterPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Visitor Info
  sessionId    String
  ipAddress    String?
  userAgent    String?
  referrer     String?

  // Engagement Metrics
  timeSpent    Int?         // Seconds on page
  scrollDepth  Int?         // Percentage scrolled
  interactions Int          @default(0)

  // Geographic
  country      String?
  city         String?

  visitedAt    DateTime     @default(now())

  @@index([pageId])
  @@index([sessionId])
  @@index([visitedAt])
}

// Interactive Elements Tracking
model RecruiterPageInteraction {
  id           String       @id @default(cuid())
  pageId       String
  page         RecruiterPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Interaction Details
  sessionId    String
  elementType  String       // "roi-calculator", "action-plan", "case-study"
  elementId    String
  actionType   String       // "click", "input", "download", "share"

  // Data Captured
  inputData    Json?        // User inputs for calculators
  result       Json?        // Calculated results
  duration     Int?         // Time spent on element

  createdAt    DateTime     @default(now())

  @@index([pageId])
  @@index([sessionId])
  @@index([elementType])
}

// Company Research Cache
model CompanyResearch {
  id             String   @id @default(cuid())
  companyName    String   @unique
  domain         String?

  // Basic Info
  size           String?  // "10-50", "100-500", "1000+"
  industry       String?
  stage          String?  // "Startup", "Growth", "Public"
  location       String?

  // Business Intelligence
  recentNews     Json?    // Latest news and announcements
  products       Json?    // Product portfolio
  competitors    Json?    // Competitive landscape
  challenges     Json?    // Identified market challenges

  // Technology Stack (if available)
  techStack      Json?

  // Update tracking
  lastResearched DateTime @default(now())
  needsUpdate    Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyName])
  @@index([industry])
}
